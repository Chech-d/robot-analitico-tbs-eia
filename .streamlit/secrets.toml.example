# PLANTILLA de secretos. Copien este archivo como ".streamlit/secrets.toml"
# (sin ".example") y completen los valores reales que entregue el curso por
# el LMS. El archivo real NUNCA debe subirse a git (ya está en .gitignore).
#
# Documentación de referencia (verificar contra la versión de Streamlit
# fijada en requirements.txt):
#   https://docs.streamlit.io/develop/api-reference/user/st.login
#   https://docs.streamlit.io/develop/concepts/connections/authentication

[auth]
# URL a la que el proveedor OIDC redirige después del login.
# En local casi siempre es esta:
redirect_uri = "http://localhost:8501/oauth2callback"
# Cadena aleatoria larga y secreta, distinta para cada entorno (local vs
# producción). Generar con, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REEMPLAZAR_POR_CADENA_ALEATORIA_LARGA"

[auth.google]
client_id = "REEMPLAZAR_CLIENT_ID_GOOGLE"
client_secret = "REEMPLAZAR_CLIENT_SECRET_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth.microsoft]
client_id = "REEMPLAZAR_CLIENT_ID_MICROSOFT"
client_secret = "REEMPLAZAR_CLIENT_SECRET_MICROSOFT"
# Sustituir <TENANT_ID> por el tenant o "common"/"organizations" según
# indique la configuración que dé el curso.
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"
